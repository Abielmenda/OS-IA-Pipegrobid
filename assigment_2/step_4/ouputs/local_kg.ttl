@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix g4: <https://g4.org/ontology/research-funding#> .
@prefix mod: <https://w3id.org/mod#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dc:creator a owl:AnnotationProperty .

dc:date a owl:DatatypeProperty ;
    rdfs:label "date" ;
    rdfs:domain g4:Paper ;
    rdfs:range xsd:string .

dc:title a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain g4:Paper ;
    rdfs:range xsd:string .

dcterms:license a owl:AnnotationProperty .

owl:versionInfo a owl:AnnotationProperty .

g4: a owl:Ontology ;
    dc:creator "G4_OPENSCIENCE" ;
    dc:title "Ontology for funding researching" ;
    dcterms:license "https://www.apache.org/licenses/LICENSE-2.0" ;
    owl:versionInfo "0.0.1" ;
    mod:createdWith <https://chowlk.linkeddata.es/> .

g4:acknowledges a owl:ObjectProperty ;
    rdfs:label "acknowledges" .

g4:algorihtm a owl:DatatypeProperty ;
    rdfs:label "algorihtm" ;
    rdfs:range xsd:string .

g4:fundedByProject a owl:ObjectProperty ;
    rdfs:label "funded by project" ;
    rdfs:domain g4:Paper ;
    rdfs:range schema:Project .

g4:fundingAmount a owl:DatatypeProperty ;
    rdfs:label "funding amount" ;
    rdfs:domain schema:Project ;
    rdfs:range xsd:decimal .

g4:keywordVector a owl:DatatypeProperty ;
    rdfs:label "keyword vector" ;
    rdfs:domain g4:Topic ;
    rdfs:range xsd:string .

g4:paper a owl:ObjectProperty ;
    rdfs:label "paper" ;
    rdfs:domain g4:PaperTopicSimilarity ;
    rdfs:range g4:Paper .

g4:paper1 a owl:ObjectProperty ;
    rdfs:label "paper1" ;
    rdfs:domain g4:PaperSimilarity ;
    rdfs:range g4:Paper .

g4:paper2 a owl:ObjectProperty ;
    rdfs:label "paper2" ;
    rdfs:domain g4:PaperSimilarity ;
    rdfs:range g4:Paper .

